import Foundation
import CryptoKit

// =====================================================
// MARK: - AGE SUMMARY (LEVEL-2 COMPRESSION)
// =====================================================

public struct DVSMAgeSummary: Sendable {

    public let metaRootHash: Data
    public let epochSpan: ClosedRange<UInt64>

    public let globalStability: Double
    public let globalDrift: Double
    public let globalEnergy: Double

    public let compressionDepth: UInt8  // always ≥ 2
}

// =====================================================
// MARK: - META-COLLAPSE OPERATOR (Λ₂)
// =====================================================

public struct DVSMMetaCollapseOperator {

    public init() {}

    /// Collapses many MetaSummaries → single bounded invariant
    /// PURE FUNCTION: deterministic, replay-stable
    public func collapse(_ metas: [DVSMMetaSummary]) -> DVSMAgeSummary {

        let span = metas.first!.epochRange.lowerBound
            ... metas.last!.epochRange.upperBound

        let stability = metas.map { $0.stabilityEnvelope }.reduce(0, +) / Double(metas.count)
        let drift = metas.map { $0.driftVariance }.reduce(0, +) / Double(metas.count)
        let energy = metas.map { $0.energyUpperbound }.max() ?? 0.0

        let raw = "\(span.lowerBound)|\(span.upperBound)|\(stability)|\(drift)|\(energy)"
        let hash = Data(SHA256.hash(data: Data(raw.utf8)))

        return DVSMAgeSummary(
            metaRootHash: hash,
            epochSpan: span,
            globalStability: stability,
            globalDrift: drift,
            globalEnergy: energy,
            compressionDepth: 2
        )
    }
}

// =====================================================
// MARK: - SAFE BOOTSTRAP FROM AGE SUMMARY
// =====================================================

public struct DVSMAgeBootstrapper {

    public init() {}

    /// Bootstraps DVSM kernel from collapsed reality only
    /// (no epoch replay required)
    public func bootstrap(
        from age: DVSMAgeSummary,
        rule: DVSMRuleEpoch
    ) -> DVSMKernel {

        let seededWindow = DVSMLedgerWindow(
            driftHistory: [age.globalDrift],
            instabilityHistory: [age.globalStability],
            rootHash: age.metaRootHash
        )

        return DVSMKernel(
            initialEpoch: rule,
            history: seededWindow
        )
    }
}

// =====================================================
// MARK: - CROSS-EPOCH DRIFT BOUNDARY LAW
// =====================================================

public struct DVSMCrossEpochDriftLaw {

    public init() {}

    /// Prevents summary drift accumulation across Λ layers
    public func clamp(_ age: DVSMAgeSummary) -> DVSMAgeSummary {

        let boundedDrift = min(age.globalDrift, 10.0)
        let boundedStability = min(age.globalStability, 10.0)

        let raw = "\(age.metaRootHash)|clamp|\(boundedDrift)|\(boundedStability)"
        let hash = Data(SHA256.hash(data: Data(raw.utf8)))

        return DVSMAgeSummary(
            metaRootHash: hash,
            epochSpan: age.epochSpan,
            globalStability: boundedStability,
            globalDrift: boundedDrift,
            globalEnergy: age.globalEnergy,
            compressionDepth: age.compressionDepth
        )
    }
}

// =====================================================
// MARK: - FAILURE MODE RESOLUTION: COLD BOOT GUARANTEE
// =====================================================

public struct DVSMColdBootValidator {

    public init() {}

    /// Ensures system can always reconstitute valid classification lattice
    /// from ANY valid AgeSummary (even degraded)
    public func validate(_ age: DVSMAgeSummary) -> Bool {

        // Must preserve invariants:
        let validDepth = age.compressionDepth >= 2
        let validSpan = age.epochSpan.lowerBound <= age.epochSpan.upperBound
        let boundedDrift = age.globalDrift >= 0 && age.globalDrift < 1000

        return validDepth && validSpan && boundedDrift
    }
}

