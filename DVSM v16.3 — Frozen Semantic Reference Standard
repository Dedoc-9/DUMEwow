// =====================================================
// MARK: - FIXED-POINT EXECUTION CONTRACT
// =====================================================
//
// All computation is performed under:
//
//   DVSMFPC (Fixed-Point Contract)
//
// Rules:
//   - no floating-point truth authority
//   - saturating arithmetic only
//   - deterministic cross-platform execution
//
// =====================================================

public struct DVSMFPC {

    public static let scale: Int64 = 1_000_000

    public static func saturatingAdd(_ lhs: Int64, _ rhs: Int64) -> Int64 {
        let (result, overflow) = lhs.addingReportingOverflow(rhs)
        if overflow {
            return rhs > 0 ? Int64.max : Int64.min
        }
        return result
    }

    public static func saturatingMul(_ lhs: Int64, _ rhs: Int64) -> Int64 {
        let product = Double(lhs) * Double(rhs)

        if product > Double(Int64.max) { return Int64.max }
        if product < Double(Int64.min) { return Int64.min }

        return Int64(product)
    }
}


