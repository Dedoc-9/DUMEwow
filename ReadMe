// =====================================================
//
// AUTHOR:
//   DVSM Extension Layer (User-defined integration)
//
// PURPOSE:
//   Introduces energy-aware, compute-scaled execution profiles
//   for large-scale or resource-constrained DVSM deployments.
//
// DESIGN GOALS:
//
//   ✔ reduce unnecessary governance overhead in stable regimes
//   ✔ enable adaptive fidelity vs compute tradeoff
//   ✔ allow energy-aware execution throttling
//   ✔ preserve deterministic semantics under scaling
//   ✔ remain fully non-invasive to core DVSM logic
//
// =====================================================

import Foundation
import CryptoKit

// =====================================================
// MARK: - SUSTAINABILITY EXECUTION MODE
// =====================================================

public enum DVSMSustainabilityMode: String, Sendable {

    /// Maximum accuracy, full governance stack enabled
    case fullFidelity

    /// Balanced mode (default for production systems)
    case adaptiveBalanced

    /// Reduced compute footprint (large-scale / edge systems)
    case efficiencyOptimized

    /// Extreme low-power / degraded compute environments
    case ultraLowPower
}

// =====================================================
// MARK: - ENERGY + COMPUTE BUDGET MODEL
// =====================================================

public struct DVSMResourceBudget: Sendable {

    /// Approximate compute allowance per cycle (abstract units)
    public var computeBudget: Double

    /// Energy sensitivity factor (higher = more aggressive throttling)
    public var energySensitivity: Double

    /// Maximum allowable governance depth (layers executed)
    public var maxGovernanceDepth: Int

    /// Whether cryptographic verification is fully enabled
    public var enableFullCryptoAudit: Bool

    public init(
        computeBudget: Double,
        energySensitivity: Double,
        maxGovernanceDepth: Int,
        enableFullCryptoAudit: Bool
    ) {
        self.computeBudget = computeBudget
        self.energySensitivity = energySensitivity
        self.maxGovernanceDepth = maxGovernanceDepth
        self.enableFullCryptoAudit = enableFullCryptoAudit
    }
}

// =====================================================
// MARK: - EXTENDED DVSM CONFIG (NON-BREAKING ADDITION)
// =====================================================

public extension DVSMConfig {

    /// Sustainability mode selector
    var sustainabilityMode: DVSMSustainabilityMode {
        get { _sustainabilityMode }
        set { _sustainabilityMode = newValue }
    }

    /// Internal backing storage (non-breaking pattern via computed shim)
    private var _sustainabilityMode: DVSMSustainabilityMode {
        get {
            // default safe fallback
            return .adaptiveBalanced
        }
        set { _ = newValue }
    }

    /// Derived resource budget from sustainability mode
    func derivedResourceBudget() -> DVSMResourceBudget {

        switch sustainabilityMode {

        case .fullFidelity:
            return DVSMResourceBudget(
                computeBudget: 1.0,
                energySensitivity: 0.1,
                maxGovernanceDepth: Int.max,
                enableFullCryptoAudit: true
            )

        case .adaptiveBalanced:
            return DVSMResourceBudget(
                computeBudget: 0.6,
                energySensitivity: 0.4,
                maxGovernanceDepth: 6,
                enableFullCryptoAudit: true
            )

        case .efficiencyOptimized:
            return DVSMResourceBudget(
                computeBudget: 0.3,
                energySensitivity: 0.7,
                maxGovernanceDepth: 3,
                enableFullCryptoAudit: false
            )

        case .ultraLowPower:
            return DVSMResourceBudget(
                computeBudget: 0.1,
                energySensitivity: 1.0,
                maxGovernanceDepth: 1,
                enableFullCryptoAudit: false
            )
        }
    }
}

// =====================================================
// MARK: - LIFECYCLE AWARE ENERGY GATE
// =====================================================

public extension DVSMSystemLifecycleManaging {

    /// Determines whether heavy governance layers should execute
    func shouldRunFullGovernance(
        state: DVSMSystemState,
        config: DVSMConfig
    ) -> Bool {

        let budget = config.derivedResourceBudget()

        guard state == .ready || state == .sealed else {
            return false
        }

        // Ultra-low-power systems bypass heavy governance
        if budget.maxGovernanceDepth <= 1 {
            return false
        }

        return budget.enableFullCryptoAudit
    }

    /// Adaptive degradation trigger for sustainability pressure
    func evaluateEnergyPressure(
        estimatedLoad: Double,
        config: DVSMConfig
    ) -> DVSMSystemState {

        let budget = config.derivedResourceBudget()

        if estimatedLoad > budget.computeBudget * 1.5 {
            return .degraded
        }

        return .ready
    }
}

// =====================================================
// MARK: - GOVERNANCE THROTTLING POLICY
// =====================================================

public struct DVSMGovernanceThrottlePolicy: Sendable {

    /// Reduces identifiability checks under low-energy mode
    public var reduceMDDChecks: Bool

    /// Disables cross-shard verification under constraints
    public var disableCrossShardVerification: Bool

    /// Skips non-critical audit DAG writes
    public var skipNonCriticalAuditWrites: Bool

    public init(
        reduceMDDChecks: Bool,
        disableCrossShardVerification: Bool,
        skipNonCriticalAuditWrites: Bool
    ) {
        self.reduceMDDChecks = reduceMDDChecks
        self.disableCrossShardVerification = disableCrossShardVerification
        self.skipNonCriticalAuditWrites = skipNonCriticalAuditWrites
    }

    /// Default policy derived from resource budget
    public static func from(_ budget: DVSMResourceBudget) -> DVSMGovernanceThrottlePolicy {

        if budget.computeBudget < 0.2 {
            return DVSMGovernanceThrottlePolicy(
                reduceMDDChecks: true,
                disableCrossShardVerification: true,
                skipNonCriticalAuditWrites: true
            )
        }

        if budget.computeBudget < 0.6 {
            return DVSMGovernanceThrottlePolicy(
                reduceMDDChecks: false,
                disableCrossShardVerification: true,
                skipNonCriticalAuditWrites: false
            )
        }

        return DVSMGovernanceThrottlePolicy(
            reduceMDDChecks: false,
            disableCrossShardVerification: false,
            skipNonCriticalAuditWrites: false
        )
    }
}

// =====================================================
// MARK: - SUSTAINABILITY AUDIT EXTENSION
// =====================================================

public struct DVSMSustainabilityAudit {

    public static func estimateEfficiencyGain(
        baselineCompute: Double,
        optimizedCompute: Double
    ) -> Double {

        guard baselineCompute > 0 else { return 0 }
        return 1.0 - (optimizedCompute / baselineCompute)
    }

    public static func validateSafeDegradation(
        mode: DVSMSustainabilityMode
    ) -> Bool {

        switch mode {
        case .ultraLowPower:
            // requires explicit external attestation in real system
            return true
        default:
            return true
        }
    }
}

