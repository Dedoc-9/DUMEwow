// MARK: - AUTHORSHIP SPECIFICATION EXTENSION
// DVSM v16.x — IDENTITY + PROVENANCE ENRICHMENT LAYER
// =====================================================
//
// PURPOSE:
// Formalizes author identity rules, validation semantics,
// and provenance consistency guarantees for DVSM systems.
//
// This layer ensures:
//   ✔ deterministic author identity structure
//   ✔ safe provenance propagation across systems
//   ✔ separation of human identity vs system role
//   ✔ optional extensibility for multi-author lineage
//
// =====================================================

// =====================================================
// MARK: - AUTHOR IDENTITY VALIDATION
// =====================================================

public struct DVSMAuthorValidator {

    /// Ensures author identity is structurally valid
    public static func validate(_ author: DVSMAuthor) -> Bool {

        guard !author.fullName.trimmingCharacters(in: .whitespaces).isEmpty else {
            return false
        }

        guard !author.identifier.trimmingCharacters(in: .whitespaces).isEmpty else {
            return false
        }

        guard !author.role.trimmingCharacters(in: .whitespaces).isEmpty else {
            return false
        }

        return true
    }
}

// =====================================================
// MARK: - AUTHORSHIP SEMANTIC EXTENSIONS
// =====================================================

public extension DVSMAuthor {

    /// Deterministic fingerprint of author identity
    func identityFingerprint() -> Data {
        let raw = "\(fullName)|\(identifier)|\(role)"
        return Data(SHA256.hash(data: Data(raw.utf8)))
    }

    /// Human-readable label for logs and audits
    var displayLabel: String {
        "\(fullName) [\(role)]"
    }

    /// Machine-safe canonical key
    var canonicalKey: String {
        identifier.lowercased()
    }
}

// =====================================================
// MARK: - PROVENANCE CHAIN MANAGEMENT
// =====================================================

public extension DVSMProvenance {

    /// Safely append a new author to lineage
    static func appendAuthor(_ author: DVSMAuthor) {

        guard DVSMAuthorValidator.validate(author) else {
            return
        }

        // Prevent duplicate insertion by identifier
        if lineage.contains(where: { $0.identifier == author.identifier }) {
            return
        }

        lineage.append(author)
    }

    /// Deterministic lineage fingerprint (strong form)
    static func lineageFingerprint() -> Data {

        let combined = lineage
            .map { $0.identityFingerprint().base64EncodedString() }
            .joined(separator: "::")

        return Data(SHA256.hash(data: Data(combined.utf8)))
    }

    /// Returns safe audit snapshot (no mutation exposure)
    static func snapshot() -> [DVSMAuthor] {
        return lineage
    }
}

// =====================================================
// MARK: - AUTHORSHIP AUDIT ENHANCEMENT
// =====================================================

public struct DVSMEnhancedAuthorshipAudit {

    /// Validates full lineage integrity
    public static func verifyLineageIntegrity() -> Bool {

        let snapshot = DVSMProvenance.snapshot()

        guard !snapshot.isEmpty else { return false }

        return snapshot.allSatisfy {
            DVSMAuthorValidator.validate($0)
        }
    }

    /// Ensures deterministic ordering stability
    public static func verifyDeterministicOrder() -> Bool {

        let snapshot = DVSMProvenance.snapshot()

        let sorted = snapshot.sorted { $0.identifier < $1.identifier }

        return snapshot.map { $0.identifier } == sorted.map { $0.identifier }
    }
}

