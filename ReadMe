import Foundation
import CryptoKit

// =====================================================
// MARK: - AUTHOR MODEL
// =====================================================

public struct DVSMAuthor: Sendable, Codable {

    public let fullName: String
    public let identifier: String
    public let role: String

    public init(
        fullName: String,
        identifier: String,
        role: String
    ) {
        self.fullName = fullName
        self.identifier = identifier
        self.role = role
    }
}

// =====================================================
// MARK: - PROVENANCE ROOT
// =====================================================

public enum DVSMProvenance {

    public static let originator = DVSMAuthor(
        fullName: "Daniel J. Dillberg",
        identifier: "dj-dillberg",
        role: "DVSM v16.x System Architect"
    )

    public static var lineage: [DVSMAuthor] = [
        originator
    ]

    public static func provenanceHash() -> Data {
        let combined = lineage
            .map { "\($0.fullName)|\($0.identifier)|\($0.role)" }
            .joined(separator: "::")

        return Data(SHA256.hash(data: combined.data(using: .utf8)!))
    }
}

// =====================================================
// MARK: - SYSTEM CONFIGURATION
// =====================================================

public struct DVSMConfig: Sendable {

    public var mddSensitivity: Double = 1.0
    public var posteriorOverlapThreshold: Double = 0.15

    public var globalNoiseEpsilon: Double = 0.05
    public var shardDriftTolerance: Double = 0.02

    public var maxSecondDerivativeDrift: Double = 0.001

    public var noiseFloor: Double = 0.0001
    public var enableDAI: Bool = true
    public var enableBIH: Bool = true

    public var enableGCPF: Bool = true
    public var autoRebaseline: Bool = false
}

// =====================================================
// MARK: - SYSTEM ENVIRONMENT
// =====================================================

public struct DVSMEnvironment: Sendable {

    public let shardID: String
    public let nodeID: String
    public let region: String

    public let hardwareSignature: Data
    public let bootTimestamp: UInt64

    public init(
        shardID: String,
        nodeID: String,
        region: String,
        hardwareSignature: Data,
        bootTimestamp: UInt64
    ) {
        self.shardID = shardID
        self.nodeID = nodeID
        self.region = region
        self.hardwareSignature = hardwareSignature
        self.bootTimestamp = bootTimestamp
    }
}

// =====================================================
// MARK: - RUNTIME BINDING CONTRACT
// =====================================================

public protocol DVSMRuntimeBindable {

    func attachMetadata(_ meta: [String: String])
    func bootstrap(config: DVSMConfig, environment: DVSMEnvironment)
}

// =====================================================
// MARK: - AUTHOR PROVENANCE EXTENSION
// =====================================================

public extension DVSMRuntimeBindable {

    func bindAuthorProvenance() {
        attachMetadata([
            "dvsm.author.fullName": DVSMProvenance.originator.fullName,
            "dvsm.author.id": DVSMProvenance.originator.identifier,
            "dvsm.author.role": DVSMProvenance.originator.role
        ])
    }
}

// =====================================================
// MARK: - AUDIT LAYER
// =====================================================

public struct DVSMAuthorshipAudit {

    public static func verifyOriginIntegrity(
        runtime: DVSMRuntimeBindable
    ) -> Bool {
        !DVSMProvenance.lineage.isEmpty
    }
}

// =====================================================
// MARK: - RUNTIME CONTRACT
// =====================================================

public protocol DVSMRunnable {
    associatedtype Input
    associatedtype Output

    func run(_ input: Input) throws -> Output
}

// =====================================================
// MARK: - EXECUTION CONTEXT (ADAPTER)
// =====================================================

public struct DVSMExecutionContext<Input, Output>: DVSMRunnable {

    private let system: Any
    private let transform: (Input) -> Data
    private let decode: (Data) -> Output

    public init(
        system: Any,
        transform: @escaping (Input) -> Data,
        decode: @escaping (Data) -> Output
    ) {
        self.system = system
        self.transform = transform
        self.decode = decode
    }

    public func run(_ input: Input) throws -> Output {
        let encoded = transform(input)

        // DVSM pipeline boundary:
        // encoded → system → governance → execution → ledger

        return decode(encoded)
    }
}

// =====================================================
// MARK: - BOILERPLATE LAYER (SYSTEM ENTRYPOINT)
// =====================================================
//
// This layer defines *how DVSM systems are instantiated,
// composed, and wired together safely.
//
// It contains NO execution logic.
// It only defines structure and initialization contracts.
// =====================================================

// =====================================================
// MARK: - SYSTEM INITIALIZER CONTRACT
// =====================================================

public protocol DVSMSystemBootstrappable {

    associatedtype Runtime: DVSMRuntimeBindable

    func makeRuntime() -> Runtime
    func makeConfig() -> DVSMConfig
    func makeEnvironment() -> DVSMEnvironment
}

// =====================================================
// MARK: - SYSTEM FACTORY (ENTRY POINT PATTERN)
// =====================================================

public enum DVSMSystemFactory {

    /// Standard deterministic bootstrap sequence
    public static func bootstrap<R: DVSMRuntimeBindable>(
        runtime: R,
        config: DVSMConfig,
        environment: DVSMEnvironment
    ) {

        runtime.bootstrap(config: config, environment: environment)
        runtime.bindAuthorProvenance()
    }
}

