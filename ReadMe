import Foundation
import CryptoKit

// =====================================================
// MARK: - AUTHOR MODEL
// =====================================================

public struct DVSMAuthor: Sendable, Codable {

    public let fullName: String
    public let identifier: String
    public let role: String

    public init(fullName: String, identifier: String, role: String) {
        self.fullName = fullName
        self.identifier = identifier
        self.role = role
    }
}

// =====================================================
// MARK: - PROVENANCE ROOT
// =====================================================

public enum DVSMProvenance {

    public static let originator = DVSMAuthor(
        fullName: "Daniel J. Dillberg",
        identifier: "dj-dillberg",
        role: "DVSM v16.x System Architect"
    )

    public static var lineage: [DVSMAuthor] = [originator]

    public static func provenanceHash() -> Data {
        let combined = lineage
            .map { "\($0.fullName)|\($0.identifier)|\($0.role)" }
            .joined(separator: "::")

        return Data(SHA256.hash(data: Data(combined.utf8)))
    }
}

// =====================================================
// MARK: - SUSTAINABILITY MODE
// =====================================================

public enum DVSMSustainabilityMode: String, Sendable {
    case fullFidelity
    case adaptiveBalanced
    case efficiencyOptimized
    case ultraLowPower
}

// =====================================================
// MARK: - SYSTEM CONFIGURATION
// =====================================================

public struct DVSMConfig: Sendable {

    public var mddSensitivity: Double = 1.0
    public var posteriorOverlapThreshold: Double = 0.15

    public var globalNoiseEpsilon: Double = 0.05
    public var shardDriftTolerance: Double = 0.02

    public var maxSecondDerivativeDrift: Double = 0.001

    public var noiseFloor: Double = 0.0001
    public var enableDAI: Bool = true
    public var enableBIH: Bool = true
    public var enableGCPF: Bool = true
    public var autoRebaseline: Bool = false

    // Core sustainability control
    public var sustainabilityMode: DVSMSustainabilityMode = .adaptiveBalanced

    public init() {}
}

// =====================================================
// MARK: - RESOURCE BUDGET MODEL
// =====================================================

public struct DVSMResourceBudget: Sendable {

    public let computeBudget: Double
    public let energySensitivity: Double
    public let maxGovernanceDepth: Int
    public let enableFullCryptoAudit: Bool
}

// =====================================================
// MARK: - DERIVED SUSTAINABILITY LOGIC
// =====================================================

public extension DVSMConfig {

    func derivedResourceBudget() -> DVSMResourceBudget {

        switch sustainabilityMode {

        case .fullFidelity:
            return DVSMResourceBudget(
                computeBudget: 1.0,
                energySensitivity: 0.1,
                maxGovernanceDepth: Int.max,
                enableFullCryptoAudit: true
            )

        case .adaptiveBalanced:
            return DVSMResourceBudget(
                computeBudget: 0.6,
                energySensitivity: 0.4,
                maxGovernanceDepth: 6,
                enableFullCryptoAudit: true
            )

        case .efficiencyOptimized:
            return DVSMResourceBudget(
                computeBudget: 0.3,
                energySensitivity: 0.7,
                maxGovernanceDepth: 3,
                enableFullCryptoAudit: false
            )

        case .ultraLowPower:
            return DVSMResourceBudget(
                computeBudget: 0.1,
                energySensitivity: 1.0,
                maxGovernanceDepth: 1,
                enableFullCryptoAudit: false
            )
        }
    }
}

// =====================================================
// MARK: - SYSTEM ENVIRONMENT
// =====================================================

public struct DVSMEnvironment: Sendable {

    public let shardID: String
    public let nodeID: String
    public let region: String
    public let hardwareSignature: Data
    public let bootTimestamp: UInt64

    public init(
        shardID: String,
        nodeID: String,
        region: String,
        hardwareSignature: Data,
        bootTimestamp: UInt64
    ) {
        self.shardID = shardID
        self.nodeID = nodeID
        self.region = region
        self.hardwareSignature = hardwareSignature
        self.bootTimestamp = bootTimestamp
    }
}

// =====================================================
// MARK: - RUNTIME BINDING CONTRACT
// =====================================================

public protocol DVSMRuntimeBindable {

    func attachMetadata(_ meta: [String: String])
    func bootstrap(config: DVSMConfig, environment: DVSMEnvironment)
}

// =====================================================
// MARK: - AUTHOR PROVENANCE EXTENSION
// =====================================================

public extension DVSMRuntimeBindable {

    func bindAuthorProvenance() {
        attachMetadata([
            "dvsm.author.fullName": DVSMProvenance.originator.fullName,
            "dvsm.author.id": DVSMProvenance.originator.identifier,
            "dvsm.author.role": DVSMProvenance.originator.role
        ])
    }
}

// =====================================================
// MARK: - RUNTIME CONTRACT
// =====================================================

public protocol DVSMRunnable {
    associatedtype Input
    associatedtype Output
    func run(_ input: Input) throws -> Output
}

// =====================================================
// MARK: - EXECUTION CONTEXT
// =====================================================

public struct DVSMExecutionContext<Input, Output>: DVSMRunnable {

    /// Opaque runtime reference (intentional abstraction boundary)
    private let system: Any

    private let transform: (Input) -> Data
    private let decode: (Data) -> Output

    public init(
        system: Any,
        transform: @escaping (Input) -> Data,
        decode: @escaping (Data) -> Output
    ) {
        self.system = system
        self.transform = transform
        self.decode = decode
    }

    public func run(_ input: Input) throws -> Output {
        let encoded = transform(input)
        return decode(encoded)
    }
}

// =====================================================
// MARK: - BOILERPLATE LAYER
// =====================================================

public protocol DVSMSystemBootstrappable {

    associatedtype Runtime: DVSMRuntimeBindable

    func makeRuntime() -> Runtime
    func makeConfig() -> DVSMConfig
    func makeEnvironment() -> DVSMEnvironment
}

// =====================================================
// MARK: - SYSTEM FACTORY
// =====================================================

public enum DVSMSystemFactory {

    public static func bootstrap<R: DVSMRuntimeBindable>(
        runtime: R,
        config: DVSMConfig,
        environment: DVSMEnvironment
    ) {
        runtime.bootstrap(config: config, environment: environment)
        runtime.bindAuthorProvenance()
    }
}

// =====================================================
// MARK: - SYSTEM STATE AUTHORITY CONTRACT
// =====================================================
//
// PURPOSE:
// Establishes DVSMSystemState as a single source of truth
// for all lifecycle, bootstrap, and sustainability transitions.
//
// RULE:
// Only DVSMSystemLifecycleManaging implementations
// are allowed to perform state transitions.
//
// All other layers (including sustainability) MUST
// request state evaluation, not mutate state directly.
// =====================================================

public protocol DVSMSystemStateAuthority {

    func currentState() -> DVSMSystemState

    func transition(
        to newState: DVSMSystemState,
        reason: String
    )
}

// =====================================================
// MARK: - SYSTEM STATE (SINGLE SOURCE OF TRUTH)
// =====================================================

public enum DVSMSystemState: String, Sendable {
    case uninitialized
    case bootstrapping
    case ready
    case sealed
    case degraded
    case failed
}

// =====================================================
// MARK: - LIFECYCLE CONTROLLER CONTRACT
// =====================================================

public protocol DVSMSystemLifecycleManaging {

    var systemState: DVSMSystemState { get }

    func beginBootstrap()
    func completeBootstrap() -> DVSMBootstrapAttestation
    func sealSystem()
    func markDegraded(reason: String)
}

// =====================================================
// MARK: - LIFECYCLE + ENERGY INTEGRATION
// =====================================================

public extension DVSMSystemLifecycleManaging {

    func shouldRunFullGovernance(
        state: DVSMSystemState,
        config: DVSMConfig
    ) -> Bool {

        let budget = config.derivedResourceBudget()

        guard state == .ready || state == .sealed else {
            return false
        }

        if budget.maxGovernanceDepth <= 1 {
            return false
        }

        return budget.enableFullCryptoAudit
    }

    func evaluateEnergyPressure(
        estimatedLoad: Double,
        config: DVSMConfig
    ) -> DVSMSystemState {

        let budget = config.derivedResourceBudget()

        if estimatedLoad > budget.computeBudget * 1.5 {
            return .degraded
        }

        return .ready
    }
}

// =====================================================
// MARK: - SUSTAINABILITY AUDIT
// =====================================================

public struct DVSMSustainabilityAudit {

    public static func estimateEfficiencyGain(
        baseline: Double,
        optimized: Double
    ) -> Double {

        guard baseline > 0 else { return 0 }
        return 1.0 - (optimized / baseline)
    }
}

